<?xml version="1.0" encoding="UTF-8"?>
<!--
  This repository vendors both dependencies as git subtrees under third_party/:
  godot-cpp (Godot 4.7.2 API) and MuJoCo. There is nothing to `repo sync`; the
  build is one step, scripts/build.sh. This manifest is kept only so the repo
  answers `repo` tooling with an empty, self-contained project set.
-->
<manifest>
  <remote name="v-sekai-fire" fetch="https://github.com/V-Sekai-fire" />
  <default remote="v-sekai-fire" sync-j="4" />
</manifest>
